{
  "name": "opengym-phase3-local-api",
  "main": "src/api-worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  "vars": {
    "API_ORIGIN": "http://localhost",
    "RP_ID": "localhost"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH",
        "class_name": "AuthCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AuthCoordinator"
      ]
    }
  ]
}
