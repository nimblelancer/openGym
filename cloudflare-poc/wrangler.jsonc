{
  "name": "opengym-phase1-local-poc",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "POC",
        "class_name": "PocStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PocStore"
      ]
    }
  ]
}
